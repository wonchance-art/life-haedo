// Regenerate with system Graphviz + Noto Sans CJK KR:
// dot -Tsvg docs/diagrams/product-workflow-20261026.dot -o docs/diagrams/rendered/product-workflow-20261026.svg
// dot -Tpng -Gdpi=144 docs/diagrams/product-workflow-20261026.dot -o docs/diagrams/rendered/product-workflow-20261026.png
// dot -Tpdf docs/diagrams/product-workflow-20261026.dot -o docs/diagrams/rendered/product-workflow-20261026.pdf
digraph HaedoWorkflow {
  graph [rankdir=LR, bgcolor="white", pad="0.32", nodesep="0.28", ranksep="0.48", splines=line,
    fontname="Noto Sans CJK KR", fontsize=12, fontcolor="#45414e", labelloc=b,
    label="\n해도 워크플로 · 현재 기능 · 2026.10.26\n각 행은 별도 사용 흐름입니다. 가져올 범위·글쓰기·번역·공개는 사용자가 결정합니다.\n계정 보관·로컬 저장·백업의 대상은 기능마다 다릅니다."];
  node [shape=box, style=filled, fillcolor="#f4f4f6", color="#91939d", penwidth=1,
    width=4.05, height=1.12, margin="0.15,0.13", fontname="Noto Sans CJK KR", fontsize=14, fontcolor="#2d2b35"];
  edge [color="#777482", penwidth=1, arrowsize=0.65];

  H1 [shape=plaintext, style="", label="INPUT\n입력", fontsize=20, height=0.72];
  H2 [shape=plaintext, style="", label="AUTOMATED PROCESS\n정해진 범위·명시 선택 뒤의 처리", fontsize=18, height=0.72];
  H3 [shape=plaintext, style="", label="OUTPUT\n결과", fontsize=20, height=0.72];

  I1 [label="뉴스 · 읽을 글 찾기\n허용된 공개 RSS\n주제·출처·콘텐츠 언어 / 명시 반응"];
  P1 [label="공개 후보 수집·중복 검사\n개인 조건으로 필터·정렬\n개인 추천을 켜면 좋아요만 활용", fillcolor="#ede9fe", color="#8874b2"];
  O1 [label="뉴스 후보 · 좋아요·담기 목록\n원문 또는 선택한 언어로 번역 열기\n담기는 읽을 목록, 추천 학습과 별개"];

  I2 [label="자료 · 근거 모으기\n선택한 본문·파일·링크·원본\n폴더와 자료 정리"];
  P2 [label="입력 검증·정확한 원문 버전 보존\n출처·발췌·연결 유지\n대상 자료의 비공개 계정 동기화", fillcolor="#ede9fe", color="#8874b2"];
  O2 [label="자료실 · 폴더 · 원문 · 발췌\n같은 계정에서 자료 이어 읽기\n링크만 보관한 자료는 본문과 구분"];

  I3 [label="글 · 자료 활용\n직접 쓴 생각·경험·사진\n활용할 정확한 자료 선택"];
  P3 [label="명시 저장·정확한 근거 유지\n대상 글의 비공개 계정 보관\n공개는 고른 사본만 명시 게시", fillcolor="#ede9fe", color="#8874b2"];
  O3 [label="내 글 · 회고 · 기존 책\n저장한 결과 재열기·파일 보관\n선택한 공개 사본"];

  I4 [label="계획 · 앞으로 할 일\n생년월일·연간/월별 계획\n목표·습관 입력과 체크"];
  P4 [label="도구별 날짜·나이 표시와 저장\n저장 성공 뒤 도구 간 이동\n계획·목표·습관의 자동 변환 없음", fillcolor="#ede9fe", color="#8874b2"];
  O4 [label="연간 계획 · 목표 진행 · 습관 체크\n연간 계획은 계정별 로컬 보관\n목표·습관은 기존 계정 동기화"];

  I5 [label="보관 · 복구\n계정과 자료공간\n직접 고른 백업·복원 범위와 파일"];
  P5 [label="계정 확인·해당 자료 수신\n형식별 백업 생성·파일 검증\n범위 확인 뒤 해당 형식으로 복원", fillcolor="#ede9fe", color="#8874b2"];
  O5 [label="계정 보관 상태 · 복원한 자료\n형식별 백업·복원\n모든 기능을 합친 단일 백업은 아님"];

  {rank=same; H1; I1; I2; I3; I4; I5;}
  {rank=same; H2; P1; P2; P3; P4; P5;}
  {rank=same; H3; O1; O2; O3; O4; O5;}
  H1 -> H2 -> H3 [style=invis, weight=100];
  H1 -> I1 -> I2 -> I3 -> I4 -> I5 [style=invis, constraint=false, weight=100];
  H2 -> P1 -> P2 -> P3 -> P4 -> P5 [style=invis, constraint=false, weight=100];
  H3 -> O1 -> O2 -> O3 -> O4 -> O5 [style=invis, constraint=false, weight=100];
  I1 -> P1 -> O1;
  I2 -> P2 -> O2;
  I3 -> P3 -> O3;
  I4 -> P4 -> O4;
  I5 -> P5 -> O5;
}
