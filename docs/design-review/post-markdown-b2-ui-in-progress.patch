+ * BLOG_POSTGRES_DATABASE=haedo_blog_qa_b2_... node tests/post-markdown-writing-browser.cjs --prepare-database
+ */
+'use strict';
+process.env.BASE_URL ||= 'http://127.0.0.1:4256';
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises'), path = require('node:path');
+const { createHash } = require('node:crypto');
+const { playwright, makeContext, ready, nav } = require('./unified-home-browser.cjs');
