+'use strict';
+const test = require('node:test'), assert = require('node:assert/strict');
+const P = require('../assets/life/photo-post.js'), M = require('../assets/life/post-markdown.js');
+
+function fixture() {
+  const doc = P.create(() => 'original', '2026-11-05T00:00:00.000Z');
+  doc.status = 'saved'; doc.title = '원래 제목'; doc.revision = 7;
+  doc.photos = ['first', 'second', 'unused'].map((id, i) => ({ id, name: id + '.png', type: 'image/png', width: 4, height: 3,
+    size: 8, digest: String(i + 1).repeat(64), blob: new Blob([new Uint8Array(8).fill(i)], { type: 'image/png' }) }));
+  doc.ops = [{ insert: '앞\n' }, { insert: { photo: { id: 'second', caption: '둘\n설명', alt: '둘' } } },
+    { insert: { photo: { id: 'first', caption: '첫 설명', alt: '하나' } } }, { insert: '끝\n' }];
+  doc.attachments = [{ type: 'book', title: '읽은 책', creator: '저자', url: 'https://example.org/book' }];
+  P.validate(doc); return doc;
+}
+
+test('new Markdown drafts have one canonical body and retain create identity/time defaults', () => {
+  const doc = P.createMarkdownDraft(() => 'new', '2026-11-05T01:02:03.000Z');
+  assert.equal(doc.format, 'life-post-md-v1'); assert.equal(doc.markdown, '&nbsp;\n');
+  assert.equal(Object.hasOwn(doc, 'ops'), false); assert.equal(doc.revision, 0);
+  assert.equal(doc.status, 'draft'); assert.equal(doc.createdAt, '2026-11-05T01:02:03.000Z');
+  assert.equal(doc.updatedAt, doc.createdAt); assert.deepEqual(doc.photos, []); assert.deepEqual(doc.attachments, []);
+  assert.equal(doc.archived, false); assert.equal(doc.replaces, null); P.validate(doc);
+});
+
+test('preparation preserves source metadata and all photo bytes/order, including unused originals', async () => {
