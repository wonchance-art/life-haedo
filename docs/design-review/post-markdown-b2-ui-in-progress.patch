+const { FakeCloud, accounts, cloud, base } = require('./life-sync-browser.cjs');
+const { MarkdownPublishCloud, syntheticSession } = require('./helpers/post-markdown-publish-cloud.cjs');
+const output = path.resolve(process.env.MARKDOWN_WRITING_OUTPUT || '.local/post-markdown-writing');
+const report = { checks: [], consoleErrors: [], pageErrors: [], external: [], dialogs: [],
+  scope: 'Real Chromium UI, SDK/IDB, B3 publication/media handlers and isolated PostgreSQL. Synthetic Auth/Storage/library transport and scoped native IDB abort. Synthetic composition events do not prove physical Korean IME behavior. Synthetic HEIC header with real JPEG view proves byte preservation, not HEIC decoding or Apple-device behavior.' };
+const sha = bytes => createHash('sha256').update(bytes).digest('hex');
+// B3's SQL fixture owns blog-original Storage paths. Route library-original
+// paths to the existing library transport instead of its blog-only assertion.
+class WritingCloud extends MarkdownPublishCloud {
+  async handle(route, device) {
+    if (/^\/storage\/v1\/object\/(?:authenticated\/)?life-library-originals(?:\/|$)/.test(new URL(route.request().url()).pathname))
+      return FakeCloud.prototype.handle.call(this, route, device);
+    return super.handle(route, device);
+  }
+}
+async function poll(read, accept, label, timeout = 30000) {
+  const start = Date.now(); let value;
+  do { value = await read(); if (accept(value)) return value; await new Promise(resolve => setTimeout(resolve, 100)); } while (Date.now() - start < timeout);
+  throw Error(label + ': ' + JSON.stringify(value));
+}
+const body = page => page.locator('.post-markdown-editor[contenteditable="true"]');
+async function documents(page) {
+  return page.evaluate(async () => {
+    const s = HaedoLife.Shell.storage, ws = await s.getActive(), rows = await s.listPhotoPosts(ws);
+    return Promise.all(rows.map(async row => {
+      const doc = await s.readPhotoPost(ws, row.id);
+      return { ...doc, photos: await Promise.all(doc.photos.map(async p => {
+        const { blob, view, ...meta } = p;
+        return { ...meta, actual: await HaedoLife.PhotoPost.digest(blob), ...(view ? { view: { ...view, blob: undefined, actual: await HaedoLife.PhotoPost.digest(view.blob) } } : {}) };
+      })), evidence: await s.readPostEvidence(ws, row.id), opsView: HaedoLife.PhotoPost.contentOps(doc) };
+    }));
+  });
+}
+async function savedByTitle(page, title) {
+  return poll(() => documents(page), docs => docs.some(d => d.title === title && d.status === 'saved'), 'saved ' + title).then(docs => docs.find(d => d.title === title && d.status === 'saved'));
