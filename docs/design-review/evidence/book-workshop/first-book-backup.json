    "books": [
      {
        "id": "4203d3d4-877b-41ac-8acb-0241173a5e0e",
        "title": "오래 좋아할 기준을 찾아서",
        "fromYear": "",
        "toYear": "",
        "question": "나는 무엇을 잘하는 사람보다 무엇을 오래 좋아하는 사람이 되고 싶었을까?",
        "chapters": [
          {
            "id": "1ad52fdb-cb49-49c0-8ae6-26597ae4c75a",
            "title": "잘하고 싶었던 마음",
            "note": "처음 일을 고를 때 나는 잘하는 사람으로 보이는 일을 먼저 생각했다. 당시 글에 남은 기대를 지금의 후회로 덮지 않고, 어떤 조건을 알 수 있었는지부터 적어 본다.",
            "versionIds": [
              "0dcb9dca-1a24-4d2b-901b-af30387af5bd"
            ],
            "insights": [
              {
                "id": "fbdd0dcb-3074-4867-bcee-88f0d6c1bab9",
                "statement": "내가 잘하는 사람으로 보이는 일보다 오래 좋아할 조건을 살피기 시작했다고 생각한다.",
                "uncertainty": "몇 편의 글만으로 변화의 방향을 확정할 수 없다. 당시 적지 않은 이유도 있었을 수 있다.",
                "supportVersionIds": [
                  "0dcb9dca-1a24-4d2b-901b-af30387af5bd"
                ],
                "counterVersionIds": [
                  "6c0a921e-aaed-46f6-ad89-868143387d59",
